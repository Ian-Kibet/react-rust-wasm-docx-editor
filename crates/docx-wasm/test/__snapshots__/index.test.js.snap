            Object {
              "data": Object {
                "children": Array [
                  Object {
                    "data": Object {
                      "preserveSpace": true,
                      "text": "permitted by law filed in accordance with the procedure established for the meeting, but no such proxy shall be voted or acted upon ",
                    },
                    "type": "text",
