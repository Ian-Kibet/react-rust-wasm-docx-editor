          "hasNumbering": false,
          "id": "085B8C6A",
          "property": Object {
            "alignment": "both",
            "runProperty": Object {
              "specVanish": true,
              "vanish": true,
            },
            "style": "Heading2",
            "tabs": Array [
              Object {
                "leader": null,
