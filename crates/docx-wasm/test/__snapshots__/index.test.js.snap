            },
            Object {
              "data": Object {
                "children": Array [
                  Object {
                    "data": Object {
                      "preserveSpace": true,
                      "text": " be held solely by means of remote communication as authorized by Section 211(a)(2) of the Delaware General Corporation Law (the “",
