            Object {
              "data": Object {
                "children": Array [
                  Object {
                    "data": Object {
                      "preserveSpace": true,
                      "text": "Stockholder Action by Written Consent Without a Meeting",
                    },
                    "type": "text",
                  },
                ],
                "runProperty": Object {
                  "bold": true,
