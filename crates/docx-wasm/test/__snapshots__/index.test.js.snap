                "children": Array [
                  Object {
                    "data": Object {
                      "preserveSpace": true,
                      "text": " that any such electronic transmission sets forth or is delivered with information from which the Company can determine (i) that the electronic transmission was transmitted by the stockholder or proxy holder or by a person or persons authorized to act for the stockholder or proxy holder and (ii) the date on which such stockholder or proxy holder or authorized person or persons transmitted such electronic transmission.",
                    },
                    "type": "text",
                  },
                ],
                "runProperty": Object {},
              },
