            Object {
              "data": Object {
                "children": Array [
                  Object {
                    "data": Object {
                      "preserveSpace": true,
                      "text": "Stockholders may, unless the certificate of incorporation otherwise provides, act by written consent to elect directors; ",
                    },
                    "type": "text",
                  },
                ],
